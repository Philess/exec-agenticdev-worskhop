{
  "name": "exec-agenticdev-worskhop",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend-only Vue album collection starter for an agentic development workshop",
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vue-tsc && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "serve": "bun --bun vite preview",
    "type-check": "bun --bun vue-tsc --noEmit",
    "test": "bun --bun vitest run",
    "data:generate": "bun scripts/generate-sales-data.mjs",
    "data:check": "bun scripts/generate-sales-data.mjs --check",
    "test:watch": "bun --bun vitest"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "^5.9.2",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^3.0.6"
  }
}
